NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password
DB_DATABASE=hlml
DB_SSL=false

JWT_SECRET=replace-with-a-long-random-secret
# SECRET_KEY is supported as a legacy fallback if JWT_SECRET is not set.
# SECRET_KEY=replace-with-a-long-random-secret

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional. If omitted, password reset links are printed in the server console.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-smtp-user
MAIL_PASS=your-smtp-password
MAIL_FROM="HLML <no-reply@example.com>"
